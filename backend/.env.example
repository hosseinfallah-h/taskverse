# ============ APP ============
APP_NAME=TaskVerse
APP_VERSION=0.0.1
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Tehran

# ============ DATABASE ============
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskverse
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============ REDIS ============
REDIS_URL=redis://localhost:6379/0

# ============ SECURITY ============
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING_USING_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_EXPIRE_DAYS=90
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ============ SMS (DISABLED until we own a provider) ============
# Leave SMS_PROVIDER empty to keep dev-mode OTP (code returned in API response).
SMS_PROVIDER=
SMS_API_BASE=
SMS_API_KEY=
SMS_PATTERN_CODE=
SMS_LINE_NUMBER=
SMS_OTP_TTL_SECONDS=120
SMS_OTP_MAX_ATTEMPTS=5

# ============ BALE BOT ============
BALE_BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN
BALE_API_BASE=https://tapi.bale.ai/bot
BALE_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_STRING

# ============ STORAGE ============
STORAGE_ROOT=storage
ATTACHMENTS_DIR=storage/attachments
MAX_UPLOAD_MB=25
ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/webp","audio/ogg","audio/mpeg","application/pdf","text/plain"]

# ============ RATE LIMITING ============
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=5/minute

# ============ ADMIN ============
ADMIN_PHONE=REPLACE_WITH_YOUR_PHONE